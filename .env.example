# Copy this file to .env and fill in the values. Never commit .env.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. claude-haiku-5-5 is much cheaper if you want to save credits.
CLAUDE_MODEL=claude-opus-5-5
